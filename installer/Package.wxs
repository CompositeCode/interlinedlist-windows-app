<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="InterlinedList"
           Manufacturer="InterlinedList"
           Version="1.0.0.0"
           UpgradeCode="F6E4FF67-5FBC-47BD-B506-D2A033685E0F"
           Language="1033"
           Compressed="yes"
           Scope="perMachine">

    <SummaryInformation Description="InterlinedList — signal streams, live." Manufacturer="InterlinedList" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="InterlinedList.ico" SourceFile="..\brand-kit\icons\windows\InterlinedList.ico" />
    <Property Id="ARPPRODUCTICON" Value="InterlinedList.ico" />
    <!-- ARPNOMODIFY is already set by the WixUI_Minimal wixlib below; redeclaring it here collides. -->
    <Property Id="ARPURLINFOABOUT" Value="https://interlinedlist.com" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="InterlinedList" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="InterlinedList" />
    </StandardDirectory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="1BF94658-594E-4F7F-998D-BFC7016BD96D">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="InterlinedList"
                  Description="InterlinedList — signal streams, live."
                  Target="[INSTALLFOLDER]InterlinedList.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="InterlinedList.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\InterlinedList" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Start Menu shortcut for the background sync utility (also autostarts; see below). -->
      <Component Id="SyncShortcut" Guid="C1F2A3B4-6D9E-4F0A-8B2C-4E7D9A1B3C56">
        <Shortcut Id="SyncStartMenuShortcut"
                  Name="InterlinedList Sync"
                  Description="Keep a local folder of documents in sync for Obsidian."
                  Target="[INSTALLFOLDER]InterlinedList.Sync.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="InterlinedList.ico" />
        <RegistryValue Root="HKCU" Key="Software\InterlinedList" Name="syncShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Register a Windows Event Log source under "Application" so the app can
         write to Event Viewer for debugging. Creating a source requires elevation
         (the MSI is perMachine/elevated); the app runs asInvoker and can only
         write to a source that already exists. The registry key is component-owned,
         so it's removed on uninstall. -->
    <Component Id="EventLogSource" Directory="INSTALLFOLDER" Guid="7C4B2E1A-9F3D-4A6B-8E2C-1D5F0A9B3C77">
      <RegistryValue Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\InterlinedList"
                     Name="EventMessageFile" Type="expandable"
                     Value="%SystemRoot%\System32\EventCreate.exe" KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\InterlinedList"
                     Name="TypesSupported" Type="integer" Value="7" />
    </Component>

    <!-- Launch the sync utility at login (per-user HKCU Run; no elevation needed to run). -->
    <Component Id="SyncAutoStart" Directory="INSTALLFOLDER" Guid="A3D9B1E2-4C7F-4B8A-9E1D-2F6C8A0B5D34">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="InterlinedListSync" Type="string"
                     Value="&quot;[INSTALLFOLDER]InterlinedList.Sync.exe&quot;" KeyPath="yes" />
    </Component>

    <!-- Event Log source for the sync utility (parallels the app's, created elevated). -->
    <Component Id="SyncEventLogSource" Directory="INSTALLFOLDER" Guid="B7E0C3F4-5A8D-4E2B-8C1F-3A9D6B2E7C15">
      <RegistryValue Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\InterlinedListSync"
                     Name="EventMessageFile" Type="expandable"
                     Value="%SystemRoot%\System32\EventCreate.exe" KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\InterlinedListSync"
                     Name="TypesSupported" Type="integer" Value="7" />
    </Component>

    <Feature Id="MainFeature" Title="InterlinedList" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="EventLogSource" />
      <ComponentRef Id="SyncShortcut" />
      <ComponentRef Id="SyncAutoStart" />
      <ComponentRef Id="SyncEventLogSource" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
