# Local development secrets for the InterlinedList WINDOWS app.
#
# Copy to `.env` (gitignored) and fill in the values, then load them into the
# current shell with:
#
#   set -a; source .env; set +a
#
# The contract suite also reads `.env` directly — it walks up from the test
# binary looking for one — so `dotnet test` works without sourcing anything.
#
# To let the env-gated `.github/workflows/contract-tests.yml` workflow run
# against the live API, push the same values to GitHub repository secrets:
#
#   gh secret set INTERLINEDLIST_EMAIL --body "$INTERLINEDLIST_EMAIL"
#   gh secret set INTERLINEDLIST_PASSWORD --body "$INTERLINEDLIST_PASSWORD"
#
# Use a dedicated test account, not your personal one. The contract suite signs
# in for real and creates and deletes real (throwaway) documents, folders, lists
# and rows on the account. It does NOT post messages, send DMs, dig, follow,
# block, create organizations, or touch linked identities — see
# InterlinedList.Contract.Tests/endpoints.manifest.tsv, which records every
# endpoint it declines to exercise and why.
#
# The sync token never expires, so treat any account used here as compromised if
# this file leaks. Each sign-in mints a standing credential that shows up in
# GET /api/user/sessions forever; the contract suite labels its tokens
# "contract-tests-<timestamp>" and revokes its own predecessors on each run, so
# it holds at one live token rather than accumulating them.

# Credentials for the env-gated contract tests in InterlinedList.Contract.Tests.
# When unset, every live test skips (xunit SkippableFact) and the suite still
# passes — so a fork or a checkout without secrets is green, not red.
INTERLINEDLIST_EMAIL=
INTERLINEDLIST_PASSWORD=

# Optional: override the API base URL. Defaults to https://interlinedlist.com
# when unset. Useful for staging probes.
#
# A trailing slash here is safe. The suite normalises it, which matters because
# naively concatenating "/api/..." onto a base that already ends in "/" produces
# "https://interlinedlist.com//api/user" and the server answers that with a 308
# redirect instead of the payload — a broken URL that reads like a dead endpoint.
INTERLINEDLIST_API_BASE_URL=https://interlinedlist.com

# Optional kill switch. Set to "off" to force the live contract tests to skip
# even when credentials are present — useful in CI, and the only way to exercise
# the skip path locally, since the .env walk-up would otherwise always find your
# credentials sitting in the repo root.
# INTERLINEDLIST_CONTRACT_TESTS=off
