<UserControl x:Class="InterlinedList.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:models="clr-namespace:InterlinedList.Models"
             xmlns:local="clr-namespace:InterlinedList.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="720"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
        <local:StringEqualsToBoolConverter x:Key="StringEqualsToBool"/>

        <!-- Text field -->
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Primary green button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Amber Dig-style button (used for Revoke / Unblock / Unmute) -->
        <Style x:Key="DigBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AF0A830"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small ghost button (Refresh) -->
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section card header text -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="MonoMetaStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Narrow numeric field, for the bounded preference values -->
        <Style x:Key="NumberFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FieldStyle}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
        </Style>

        <Style x:Key="PrefRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,16,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrefCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Account-status banner -->
            <RowDefinition Height="Auto"/>  <!-- Error banner -->
            <RowDefinition Height="*"/>     <!-- Sections -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <TextBlock Text="Settings"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Working…"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- ============ Account-status banner (#50) ============ -->
        <!-- The web puts this at the top of the home page. MainWindow is the
             equivalent home here, but it's in flight (#149), so it lands at the
             top of Settings for now — same block, different host. Amber for
             probation (recoverable), the view's existing #FFE81123 error red for
             restricted/suspended/banned. -->
        <Border Grid.Row="1"
                BorderThickness="0,0,0,1"
                Padding="20,12"
                Visibility="{Binding AccountStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Danger is the safer default: an unknown status must not
                         read as a mild, recoverable one. -->
                    <Setter Property="Background" Value="#1AE81123"/>
                    <Setter Property="BorderBrush" Value="#66E81123"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AccountStatus.Severity}" Value="warning">
                            <Setter Property="Background" Value="#1AF0A830"/>
                            <Setter Property="BorderBrush" Value="#66F0A830"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 4px status edge, same vocabulary as the post cards -->
                <Border Grid.Column="0" Width="4" CornerRadius="3" Margin="0,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFE81123"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AccountStatus.Severity}" Value="warning">
                                    <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountStatus.Headline}"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFE81123"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountStatus.Severity}" Value="warning">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding AccountStatus.Detail}"
                               FontSize="12"
                               Foreground="{DynamicResource TextBodyBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <!-- Name what's locked, so nothing fails on click unexplained. -->
                    <TextBlock Text="{Binding AccountStatus.LockedFeatures, StringFormat='Locked: {0}'}"
                               Style="{StaticResource MonoMetaStyle}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding AccountStatus.HasLockedFeatures, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="{Binding AccountStatus.ActionLabel}"
                        Command="{Binding OpenAccountStatusActionCommand}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Visibility="{Binding AccountStatus.ActionLabel, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DigBtnStyle}">
                            <Setter Property="BorderBrush" Value="#FFE81123"/>
                            <Setter Property="Foreground" Value="#FFE81123"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AccountStatus.Severity}" Value="warning">
                                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2"
                Background="#1AE81123"
                Padding="20,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#FFE81123"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Sections -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16">
            <StackPanel>

                <!-- ============ Profile ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Profile" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Change how you appear to others."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <TextBlock Text="Display name"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Bio"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <CheckBox Content="Private account"
                                  IsChecked="{Binding IsPrivateAccount}"
                                  Foreground="{DynamicResource TextBodyBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,12"/>

                        <Button Content="Save"
                                Command="{Binding SaveProfileCommand}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryBtnStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Preferences (#46) ============ -->
                <!-- These are the server-side preferences from GET /api/user,
                     written back with PATCH /api/user/update. Field names, the
                     viewingPreference enum and every range below were verified
                     live 2026-09-16. Editing them here is half the job: each one
                     also has a consumption point elsewhere in the app, noted per
                     control so the remaining wiring is obvious. -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Preferences" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="These follow your account, so a change made on the web shows up here too — and the other way round."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,16"/>

                        <!-- Theme -->
                        <TextBlock Text="Theme"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Light or Dark pins the app; Follow Windows tracks the OS setting."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,16">
                            <RadioButton Content="Follow Windows" GroupName="PrefTheme"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding Theme, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=system}"/>
                            <RadioButton Content="Light" GroupName="PrefTheme"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding Theme, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=light}"/>
                            <RadioButton Content="Dark" GroupName="PrefTheme"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding Theme, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=dark}"/>
                        </WrapPanel>

                        <!-- Viewing preference -->
                        <TextBlock Text="Home feed shows"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Saved on your account. The feed itself still needs wiring — see the note below."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,16">
                            <RadioButton Content="My messages" GroupName="PrefViewing"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding ViewingPreference, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=my_messages}"/>
                            <RadioButton Content="All messages" GroupName="PrefViewing"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding ViewingPreference, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=all_messages}"/>
                            <RadioButton Content="Followers only" GroupName="PrefViewing"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding ViewingPreference, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=followers_only}"/>
                            <RadioButton Content="Following only" GroupName="PrefViewing"
                                         Style="{StaticResource PrefRadioStyle}"
                                         IsChecked="{Binding ViewingPreference, Mode=TwoWay,
                                                     Converter={StaticResource StringEqualsToBool},
                                                     ConverterParameter=following_only}"/>
                        </WrapPanel>

                        <!-- Bounded numbers -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Max message length"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="1–10000. Drives the composer's counter."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MaxMessageLength, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumberFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Messages per page"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="10–30. Feed page size."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MessagesPerPage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumberFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alerts kept in tray"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="10–40. Alerts rail fetch limit."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NotificationTrayLimit, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumberFieldStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Toggles -->
                        <CheckBox Content="Show link preview cards in the feed"
                                  IsChecked="{Binding ShowPreviews}"
                                  Style="{StaticResource PrefCheckStyle}"/>
                        <CheckBox Content="New posts are publicly visible by default"
                                  IsChecked="{Binding DefaultPubliclyVisible}"
                                  Style="{StaticResource PrefCheckStyle}"/>
                        <CheckBox Content="Show advanced post settings (media &amp; cross-posting)"
                                  IsChecked="{Binding ShowAdvancedPostSettings}"
                                  Style="{StaticResource PrefCheckStyle}"
                                  Margin="0,0,0,16"/>

                        <!-- Location -->
                        <TextBlock Text="Profile location"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Optional, decimal degrees. Leave blank to skip — the app has no location-aware widgets yet."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Latitude" Style="{StaticResource MonoMetaStyle}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumberFieldStyle}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Longitude" Style="{StaticResource MonoMetaStyle}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumberFieldStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Save preferences"
                                    Command="{Binding SavePreferencesCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Reload from server"
                                    Command="{Binding ReloadPreferencesCommand}"
                                    Style="{StaticResource SmallBtnStyle}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   Text="Theme takes effect immediately. The composer counter, feed page size, feed filter, link previews and the Alerts tray limit read these values from your account — that wiring lands with the feed and shell work (see #46)."/>
                    </StackPanel>
                </Border>

                <!-- ============ Account ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Account" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Update your avatar or email address."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <TextBlock Text="Avatar image URL"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Set avatar"
                                    Command="{Binding SetAvatarCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"/>
                        </DockPanel>

                        <TextBlock Text="New email address"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Request change"
                                    Command="{Binding ChangeEmailCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"/>
                        </DockPanel>

                        <TextBlock Text="Subscription &amp; billing are managed on the web."
                                   Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6"/>
                        <Button Content="Manage account on the web"
                                Command="{Binding OpenWebAccountCommand}"
                                Style="{StaticResource DigBtnStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- ============ API sessions ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="API sessions" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Each of these is a standing sync-token. Revoke one to cut off a lost or unrecognized device."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="Refresh"
                                    Command="{Binding LoadSessionsCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource SmallBtnStyle}"/>
                        </Grid>

                        <!-- The list can be hundreds of rows — bound inner scroller. -->
                        <ScrollViewer MaxHeight="260"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ApiSession}">
                                        <Border Margin="0,0,0,8"
                                                Background="{DynamicResource Surface2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DeviceLabelOrFallback}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <Border Background="{DynamicResource Surface3Brush}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="(this device)"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CreatedFormatted, StringFormat='Created {0}'}"
                                                               Style="{StaticResource MonoMetaStyle}"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding LastUsedFormatted, StringFormat='Last used {0}'}"
                                                               Style="{StaticResource MonoMetaStyle}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Revoke"
                                                        Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource DigBtnStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ============ Notifications ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Choose which events reach you, and how."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <ItemsControl ItemsSource="{Binding Preferences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NotificationPrefViewModel}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <CheckBox Content="Push"
                                                          IsChecked="{Binding Push, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextBodyBrush}"
                                                          FontSize="12"
                                                          Margin="0,0,14,0"
                                                          VerticalAlignment="Center"/>
                                                <CheckBox Content="In-app"
                                                          IsChecked="{Binding InApp, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextBodyBrush}"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Blocked & muted ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Blocked &amp; muted" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="People you've blocked or muted. Remove them here to restore visibility."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <!-- Blocked -->
                        <TextBlock Text="Blocked"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding BlockedUsers}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ModeratedUser}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    CornerRadius="999"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Surface3Brush}"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayNameOrUsername}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Handle}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Unblock"
                                                    Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DigBtnStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Muted -->
                        <TextBlock Text="Muted"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding MutedUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ModeratedUser}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    CornerRadius="999"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Surface3Brush}"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayNameOrUsername}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Handle}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Unmute"
                                                    Command="{Binding DataContext.UnmuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DigBtnStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Data export ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Data export" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Download your data as CSV. You choose where to save each file."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>
                        <WrapPanel>
                            <Button Content="Export messages"
                                    Command="{Binding ExportMessagesCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                            <Button Content="Export lists"
                                    Command="{Binding ExportListsCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                            <Button Content="Export list rows"
                                    Command="{Binding ExportListRowsCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                            <Button Content="Export follows"
                                    Command="{Binding ExportFollowsCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Danger zone ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="#66E81123"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Danger zone" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Delete your account permanently. This cannot be undone. Type your username to confirm."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>
                        <TextBox Text="{Binding DeleteConfirmUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldStyle}" Margin="0,0,0,10"/>
                        <Button Content="Delete my account"
                                Command="{Binding DeleteAccountCommand}"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DigBtnStyle}">
                                    <Setter Property="BorderBrush" Value="#FFE81123"/>
                                    <Setter Property="Foreground" Value="#FFE81123"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
