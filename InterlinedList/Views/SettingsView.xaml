<UserControl x:Class="InterlinedList.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:models="clr-namespace:InterlinedList.Models"
             xmlns:local="clr-namespace:InterlinedList.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="720"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>

        <!-- Text field -->
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Primary green button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Amber Dig-style button (used for Revoke / Unblock / Unmute) -->
        <Style x:Key="DigBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AF0A830"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small ghost button (Refresh) -->
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section card header text -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="MonoMetaStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Error banner -->
            <RowDefinition Height="*"/>     <!-- Sections -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <TextBlock Text="Settings"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Working…"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="1"
                Background="#1AE81123"
                Padding="20,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#FFE81123"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Sections -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16">
            <StackPanel>

                <!-- ============ Profile ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Profile" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Change how you appear to others."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <TextBlock Text="Display name"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Bio"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <CheckBox Content="Private account"
                                  IsChecked="{Binding IsPrivateAccount}"
                                  Foreground="{DynamicResource TextBodyBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,12"/>

                        <Button Content="Save"
                                Command="{Binding SaveProfileCommand}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryBtnStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Account ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Account" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Update your avatar or email address."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <TextBlock Text="Avatar image URL"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Set avatar"
                                    Command="{Binding SetAvatarCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"/>
                        </DockPanel>

                        <TextBlock Text="New email address"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Request change"
                                    Command="{Binding ChangeEmailCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ API sessions ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="API sessions" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Each of these is a standing sync-token. Revoke one to cut off a lost or unrecognized device."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="Refresh"
                                    Command="{Binding LoadSessionsCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource SmallBtnStyle}"/>
                        </Grid>

                        <!-- The list can be hundreds of rows — bound inner scroller. -->
                        <ScrollViewer MaxHeight="260"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ApiSession}">
                                        <Border Margin="0,0,0,8"
                                                Background="{DynamicResource Surface2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DeviceLabelOrFallback}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <Border Background="{DynamicResource Surface3Brush}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="(this device)"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CreatedFormatted, StringFormat='Created {0}'}"
                                                               Style="{StaticResource MonoMetaStyle}"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding LastUsedFormatted, StringFormat='Last used {0}'}"
                                                               Style="{StaticResource MonoMetaStyle}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Revoke"
                                                        Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource DigBtnStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ============ Notifications ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Choose which events reach you, and how."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <ItemsControl ItemsSource="{Binding Preferences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NotificationPrefViewModel}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <CheckBox Content="Push"
                                                          IsChecked="{Binding Push, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextBodyBrush}"
                                                          FontSize="12"
                                                          Margin="0,0,14,0"
                                                          VerticalAlignment="Center"/>
                                                <CheckBox Content="In-app"
                                                          IsChecked="{Binding InApp, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextBodyBrush}"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Blocked & muted ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Blocked &amp; muted" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="People you've blocked or muted. Remove them here to restore visibility."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>

                        <!-- Blocked -->
                        <TextBlock Text="Blocked"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding BlockedUsers}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ModeratedUser}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    CornerRadius="999"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Surface3Brush}"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayNameOrUsername}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Handle}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Unblock"
                                                    Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DigBtnStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Muted -->
                        <TextBlock Text="Muted"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding MutedUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ModeratedUser}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    CornerRadius="999"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Surface3Brush}"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayNameOrUsername}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Handle}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Unmute"
                                                    Command="{Binding DataContext.UnmuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DigBtnStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Data export ============ -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Data export" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Download your data as CSV. You choose where to save each file."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,12"/>
                        <WrapPanel>
                            <Button Content="Export messages"
                                    Command="{Binding ExportMessagesCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                            <Button Content="Export lists"
                                    Command="{Binding ExportListsCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                            <Button Content="Export list rows"
                                    Command="{Binding ExportListRowsCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                            <Button Content="Export follows"
                                    Command="{Binding ExportFollowsCommand}"
                                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
