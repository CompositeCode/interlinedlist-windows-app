<UserControl x:Class="InterlinedList.Views.FeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:local="clr-namespace:InterlinedList.Views"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>

        <!-- Primary green button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Amber Dig button -->
        <Style x:Key="DigBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AF0A830"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle card action (Reply / Edit / Delete / Report) -->
        <Style x:Key="CardActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable author name → opens their profile -->
        <Style x:Key="AuthorLinkBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Compose -->
            <RowDefinition Height="Auto"/>  <!-- Error banner -->
            <RowDefinition Height="*"/>     <!-- Post list -->
        </Grid.RowDefinitions>

        <!-- Feed header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <TextBlock Text="Feed"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Loading…"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{Binding ScheduledToggleLabel}"
                            Command="{Binding ToggleScheduledCommand}"
                            Style="{StaticResource CardActionBtnStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compose -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel>
                <TextBox Text="{Binding ComposeText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="52"
                         MaxHeight="120"
                         Padding="10,8"
                         FontSize="13"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBodyBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Bluesky"
                              IsChecked="{Binding CrossPostToBluesky}"
                              Visibility="{Binding IsBlueskyLinked, Converter={StaticResource BoolToVisibility}}"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>
                    <CheckBox Content="Twitter"
                              IsChecked="{Binding CrossPostToTwitter}"
                              Visibility="{Binding IsTwitterLinked, Converter={StaticResource BoolToVisibility}}"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>
                    <CheckBox Content="Mastodon"
                              IsChecked="{Binding CrossPostToMastodon}"
                              Visibility="{Binding MastodonProvider, Converter={StaticResource NullOrEmptyToVisibility}}"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Attached images (uploaded, pending post) -->
                <ItemsControl ItemsSource="{Binding AttachedImageUrls}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6" Width="52" Height="52" CornerRadius="4"
                                    ClipToBounds="True" Background="{DynamicResource Surface3Brush}">
                                <Grid>
                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Width="16" Height="16" Padding="0" FontSize="9"
                                            Background="#99000000" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Attached videos (uploaded, pending post) -->
                <ItemsControl ItemsSource="{Binding AttachedVideoUrls}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Background="{DynamicResource Surface3Brush}"
                                    CornerRadius="3" Padding="8,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕"
                                            Command="{Binding DataContext.RemoveVideoAttachmentCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CardActionBtnStyle}"/>
                                    <TextBlock Text="🎬 video attached" FontSize="11"
                                               Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Schedule -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <CheckBox Content="Schedule"
                              IsChecked="{Binding IsScheduling}"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding ScheduleDate}" Width="130"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                Visibility="{Binding IsScheduling, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}"
                             Width="56" VerticalAlignment="Center" Padding="6,3"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Visibility="{Binding IsScheduling, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="local HH:mm" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsScheduling, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Content="Add image"
                            Command="{Binding AttachImageCommand}"
                            Style="{StaticResource DigBtnStyle}"/>
                    <Button DockPanel.Dock="Left"
                            Content="Add video"
                            Command="{Binding AttachVideoCommand}"
                            Style="{StaticResource DigBtnStyle}"
                            Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right"
                            Content="Post"
                            Command="{Binding PostCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2"
                Background="#1AE81123"
                Padding="20,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#FFE81123"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Post list -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12">
            <StackPanel>
              <!-- Normal feed (hidden while viewing scheduled) -->
              <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowScheduled}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ItemsControl x:Name="FeedList"
                              ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                            <Border Margin="0,0,0,8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left edge: amber once you've Dug it, teal otherwise -->
                                    <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource TealBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DugByMe}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Card content -->
                                    <StackPanel Grid.Column="1" Margin="12,10">

                                        <!-- Header row -->
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left"
                                                    Width="24" Height="24"
                                                    CornerRadius="999"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Surface3Brush}"
                                                    Margin="0,0,8,0">
                                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Button DockPanel.Dock="Left"
                                                    Content="{Binding AuthorDisplayName}"
                                                    Command="{Binding OpenAuthorCommand}"
                                                    Style="{StaticResource AuthorLinkBtnStyle}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0"/>
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding AuthorHandle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding TimeFormatted}"
                                                       FontFamily="JetBrains Mono, Consolas"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <!-- Body -->
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextBodyBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Margin="0,0,0,8"/>

                                        <!-- Attached images -->
                                        <ItemsControl ItemsSource="{Binding ImageUrls}" Margin="0,0,0,8"
                                                      Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6" CornerRadius="4"
                                                            ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Image Source="{Binding}" Stretch="Uniform" MaxHeight="320"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Attached videos (open in browser) -->
                                        <ItemsControl ItemsSource="{Binding VideoUrls}" Margin="0,0,0,8"
                                                      Visibility="{Binding HasVideos, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="🎬 Play video"
                                                            Command="{Binding DataContext.OpenVideoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CardActionBtnStyle}"
                                                            HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Footer: Dig + actions -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Dig"
                                                    Command="{Binding DigCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DigBtnStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DugByMe}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="{Binding DigCount}"
                                                       FontFamily="JetBrains Mono, Consolas"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,12,0"/>
                                            <Button Content="Reply" Command="{Binding StartReplyCommand}"
                                                    Style="{StaticResource CardActionBtnStyle}"/>
                                            <Button Content="Replies" Command="{Binding ToggleRepliesCommand}"
                                                    Style="{StaticResource CardActionBtnStyle}"/>
                                            <Button Content="Edit" Command="{Binding StartEditCommand}"
                                                    Style="{StaticResource CardActionBtnStyle}"
                                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Delete" Command="{Binding DeleteCommand}"
                                                    Style="{StaticResource CardActionBtnStyle}"
                                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Report" Command="{Binding ReportCommand}"
                                                    Style="{StaticResource CardActionBtnStyle}"
                                                    Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>

                                        <!-- Inline edit -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="44" Padding="8,6" FontSize="13"
                                                     Background="{DynamicResource Surface2Brush}"
                                                     Foreground="{DynamicResource TextBodyBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                                        Style="{StaticResource CardActionBtnStyle}" Margin="0,0,6,0"/>
                                                <Button Content="Save" Command="{Binding SaveEditCommand}"
                                                        Style="{StaticResource PrimaryBtnStyle}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Reply composer -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsComposingReply, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="44" Padding="8,6" FontSize="13"
                                                     Background="{DynamicResource Surface2Brush}"
                                                     Foreground="{DynamicResource TextBodyBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Button Content="Cancel" Command="{Binding CancelReplyCommand}"
                                                        Style="{StaticResource CardActionBtnStyle}" Margin="0,0,6,0"/>
                                                <Button Content="Reply" Command="{Binding PostReplyCommand}"
                                                        Style="{StaticResource PrimaryBtnStyle}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Replies -->
                                        <ItemsControl ItemsSource="{Binding Replies}" Margin="12,8,0,0"
                                                      Visibility="{Binding AreRepliesVisible, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                                                    <Border Margin="0,0,0,6"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3" Padding="10,8">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding AuthorDisplayName}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding AuthorHandle}"
                                                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeFormatted}"
                                                                           FontFamily="JetBrains Mono, Consolas" FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Content}" FontSize="12"
                                                                       Foreground="{DynamicResource TextBodyBrush}"
                                                                       TextWrapping="Wrap" LineHeight="18"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Load more"
                        Command="{Binding LoadMoreCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,16"
                        Style="{StaticResource DigBtnStyle}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"/>
              </StackPanel>

              <!-- Scheduled posts (shown via the header toggle) -->
              <StackPanel Visibility="{Binding ShowScheduled, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Scheduled posts"
                             FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextBrush}"
                             Margin="0,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding ScheduledMessages}">
                      <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                              <Border Margin="0,0,0,8"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1" CornerRadius="4" Padding="12,10">
                                  <StackPanel>
                                      <TextBlock Text="⏱ Scheduled" FontSize="10" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AmberBrush}" Margin="0,0,0,4"/>
                                      <TextBlock Text="{Binding Content}" FontSize="13"
                                                 Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap"/>
                                  </StackPanel>
                              </Border>
                          </DataTemplate>
                      </ItemsControl.ItemTemplate>
                  </ItemsControl>
              </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
