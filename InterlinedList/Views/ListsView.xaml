<UserControl x:Class="InterlinedList.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:models="clr-namespace:InterlinedList.Models"
             xmlns:local="clr-namespace:InterlinedList.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
        <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle row action (Edit / Delete) -->
        <Style x:Key="RowActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tiny caption above a field, so a dense column row stays readable -->
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Compact field for the column editor's dense grid -->
        <Style x:Key="MicroFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FieldStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="MicroCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Dropdown item: templated so the dark theme's own brushes win over
             the system highlight colours the default ComboBoxItem uses. -->
        <Style x:Key="FieldComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Type picker. Templated rather than themed-by-setters because the
             default chrome ignores the theme brushes on the drop-down button. -->
        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,4,22,4"
                                              VerticalAlignment="Center"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Date box. The calendar popup keeps its platform look; the field
             itself is painted from the theme so it isn't a white slab in dark mode. -->
        <Style x:Key="FieldDateStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- ── Row grid cells, rendered by column type (not as JSON) ────────── -->
        <DataTemplate x:Key="CellTextTemplate">
            <StackPanel Margin="0,0,16,6" MaxWidth="240">
                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}"/>
                <TextBlock Text="{Binding Text}"
                           FontSize="12"
                           Foreground="{DynamicResource TextBodyBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CellBoolTemplate">
            <StackPanel Margin="0,0,16,6">
                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}"/>
                <Grid>
                    <CheckBox IsChecked="{Binding Flag, Mode=OneWay}"
                              IsEnabled="False"
                              Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="—"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasValue, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CellChipsTemplate">
            <StackPanel Margin="0,0,16,6" MaxWidth="260">
                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}"/>
                <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Margin="0,0,4,4">
                                <TextBlock Text="{Binding}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextBodyBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="—"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding HasValue, Converter={StaticResource InverseBoolToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="RowCellStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource CellTextTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                    <Setter Property="ContentTemplate" Value="{StaticResource CellBoolTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Chips">
                    <Setter Property="ContentTemplate" Value="{StaticResource CellChipsTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Typed row form: one control per column type ───────────────────── -->
        <DataTemplate x:Key="FieldControlText">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MicroFieldStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldControlLongText">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MicroFieldStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="54" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldControlBoolean">
            <ComboBox ItemsSource="{Binding BoolOptions}"
                      SelectedItem="{Binding BoolSelection}"
                      Style="{StaticResource FieldComboStyle}"
                      MinHeight="26" Width="132"
                      HorizontalAlignment="Left"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldControlSelect">
            <ComboBox ItemsSource="{Binding SelectOptions}"
                      SelectedItem="{Binding SelectedOption}"
                      Style="{StaticResource FieldComboStyle}"
                      MinHeight="26" MinWidth="180"
                      HorizontalAlignment="Left"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldControlDate">
            <DatePicker SelectedDate="{Binding DateValue}"
                        Style="{StaticResource FieldDateStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldControlDateTime">
            <StackPanel Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding DateValue}"
                            Style="{StaticResource FieldDateStyle}"/>
                <TextBox Text="{Binding TimeValue, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MicroFieldStyle}"
                         Width="68"
                         Margin="6,0,0,0"/>
                <TextBlock Text="HH:MM"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldControlMultiSelect">
            <ItemsControl ItemsSource="{Binding MultiOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Value}"
                                  IsChecked="{Binding IsSelected}"
                                  Style="{StaticResource MicroCheckStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="RowFieldControlStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource FieldControlText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="LongText">
                    <Setter Property="ContentTemplate" Value="{StaticResource FieldControlLongText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                    <Setter Property="ContentTemplate" Value="{StaticResource FieldControlBoolean}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Select">
                    <Setter Property="ContentTemplate" Value="{StaticResource FieldControlSelect}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="MultiSelect">
                    <Setter Property="ContentTemplate" Value="{StaticResource FieldControlMultiSelect}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Date">
                    <Setter Property="ContentTemplate" Value="{StaticResource FieldControlDate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DateTime">
                    <Setter Property="ContentTemplate" Value="{StaticResource FieldControlDateTime}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowFieldTemplate" DataType="{x:Type vm:ListRowFieldViewModel}">
            <StackPanel Margin="0,0,0,10"
                        Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}"/>
                    <TextBlock Text=" *"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{DynamicResource AmberBrush}"
                               Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding TypeLabel, StringFormat=' · {0}'}" Style="{StaticResource CaptionStyle}"/>
                    <TextBlock Text="{Binding Key, StringFormat=' · {0}'}"
                               Style="{StaticResource CaptionStyle}"
                               FontFamily="JetBrains Mono, Consolas"/>
                    <TextBlock Text="{Binding StepHint, StringFormat=' · {0}'}"
                               Style="{StaticResource CaptionStyle}"
                               Visibility="{Binding StepHint, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                </StackPanel>

                <ContentControl Content="{Binding}" Style="{StaticResource RowFieldControlStyle}"/>

                <TextBlock Text="{Binding HelpText}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Visibility="{Binding HelpText, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                <TextBlock Text="{Binding Placeholder, StringFormat='e.g. {0}'}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Visibility="{Binding Placeholder, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="11"
                           Foreground="#FFE81123"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left pane: create + browse lists ─────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Lists"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="16,16,16,12"/>

                <!-- Create list form -->
                <StackPanel Grid.Row="1" Margin="16,0,16,12">
                    <TextBox Text="{Binding NewListTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}"
                             Tag="Title"/>
                    <TextBox Text="{Binding NewListDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="52"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create list"
                                Command="{Binding CreateListCommand}"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Margin="0,0,6,0"/>
                        <Button Content="Define columns"
                                Command="{Binding ColumnEditor.OpenForNewListCommand}"
                                Style="{StaticResource SmallBtnStyle}"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFE81123"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                    <TextBlock Text="Loading…"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Lists browser -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,0,16,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Lists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ListSummary}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       Margin="0,2,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="View"
                                                        Command="{Binding DataContext.SelectListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtnStyle}"/>
                                                <Button Content="Columns"
                                                        Command="{Binding DataContext.OpenColumnEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtnStyle}"/>
                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.DeleteListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtnStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shared with me -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SharedWithMe.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Shared with me"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding SharedWithMe}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WatchedList}">
                                        <Button Command="{Binding DataContext.SelectSharedListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Margin="0,0,0,8">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="10,8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding OwnerHandle}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding RoleLabel, StringFormat=' · {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Right pane: selected list's rows ──────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <!-- Own-list title (hidden while viewing a shared list) -->
                    <TextBlock Text="{Binding SelectedList.Title}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Shared-list read-only header -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsViewingShared, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedSharedList.Title}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding SelectedSharedList.OwnerHandle, StringFormat='shared by {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,3,0,0"/>
                        <TextBlock Text="{Binding SelectedSharedList.RoleLabel, StringFormat=' · {0} · read-only'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Select a list to view its rows."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="{Binding SelectedList, Converter={StaticResource InverseNullToVisibility}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Loading…"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsLoadingRows, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,12">
                <StackPanel>
                    <!-- ── Column form builder (#18) ──────────────────────────────
                         Add / edit / remove / reorder columns across all twelve
                         field types. Saving an existing list goes through the
                         non-destructive `properties` PUT, which accepts only six
                         of them — hence the warnings, which appear the moment a
                         rebuild-only type is picked rather than at save time. -->
                    <Border Margin="0,0,0,12"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Visibility="{Binding ColumnEditor.IsOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        Content="Close"
                                        Command="{Binding ColumnEditor.CloseCommand}"
                                        Style="{StaticResource RowActionBtnStyle}"/>
                                <TextBlock Text="{Binding ColumnEditor.HeaderText}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Rows are keyed by each column's key, never by its label. A saved column's key can't change — rename the label instead."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding ColumnEditor.Columns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ListColumnDraftViewModel}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,8">
                                            <StackPanel>
                                                <!-- Label · type · order · remove -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="168"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Label" Style="{StaticResource CaptionStyle}"/>
                                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MicroFieldStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="Type" Style="{StaticResource CaptionStyle}"/>
                                                        <ComboBox ItemsSource="{Binding Source={x:Static vm:ListColumnDraftViewModel.TypeOptions}}"
                                                                  DisplayMemberPath="Caption"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Type}"
                                                                  Style="{StaticResource FieldComboStyle}"
                                                                  MinHeight="26"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <Button Content="Up"
                                                                Command="{Binding DataContext.ColumnEditor.MoveColumnUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource RowActionBtnStyle}"/>
                                                        <Button Content="Down"
                                                                Command="{Binding DataContext.ColumnEditor.MoveColumnDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource RowActionBtnStyle}"/>
                                                        <Button Content="Remove"
                                                                Command="{Binding DataContext.ColumnEditor.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource RowActionBtnStyle}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Key · default -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Key" Style="{StaticResource CaptionStyle}"/>
                                                        <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsReadOnly="{Binding IsExistingColumn}"
                                                                 FontFamily="JetBrains Mono, Consolas"
                                                                 Style="{StaticResource MicroFieldStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DefaultHint, StringFormat='Default ({0})'}"
                                                                   Style="{StaticResource CaptionStyle}"/>
                                                        <TextBox Text="{Binding DefaultValueText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MicroFieldStyle}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Placeholder · help text -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Placeholder" Style="{StaticResource CaptionStyle}"/>
                                                        <TextBox Text="{Binding Placeholder, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MicroFieldStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Help text" Style="{StaticResource CaptionStyle}"/>
                                                        <TextBox Text="{Binding HelpText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MicroFieldStyle}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Options (select / multiselect / priority) -->
                                                <StackPanel Margin="0,0,0,6"
                                                            Visibility="{Binding RequiresOptions, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Options (comma-separated, at least one)" Style="{StaticResource CaptionStyle}"/>
                                                    <TextBox Text="{Binding OptionsText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource MicroFieldStyle}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox Content="Required"
                                                              IsChecked="{Binding IsRequired}"
                                                              Style="{StaticResource MicroCheckStyle}"/>
                                                    <CheckBox Content="Visible"
                                                              IsChecked="{Binding IsVisible}"
                                                              Style="{StaticResource MicroCheckStyle}"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding KeyNote}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding KeyNote, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                                                <TextBlock Text="{Binding TypeWarning}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AmberBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding TypeWarning, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                                                <TextBlock Text="{Binding IssueMessage}"
                                                           FontSize="11"
                                                           Foreground="#FFE81123"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding IssueMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ColumnEditor.RemovalWarning}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AmberBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding ColumnEditor.RemovalWarning, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                            <TextBlock Text="{Binding ColumnEditor.RebuildOnlyWarning}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AmberBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ColumnEditor.RebuildOnlyWarning, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                            <TextBlock Text="{Binding ColumnEditor.ErrorMessage}"
                                       FontSize="11"
                                       Foreground="#FFE81123"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ColumnEditor.ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                            <TextBlock Text="{Binding ColumnEditor.StatusMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ColumnEditor.StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                            <!-- 409: the server named the columns that still hold data.
                                 Confirmed in place — no native message box (dispatcher rule). -->
                            <Border Margin="0,8,0,0"
                                    Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource AmberBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,8"
                                    Visibility="{Binding ColumnEditor.NeedsForceConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ColumnEditor.ForceConfirmationMessage}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextBodyBrush}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Content="Keep them"
                                                Command="{Binding ColumnEditor.CancelForcedSaveCommand}"
                                                Style="{StaticResource RowActionBtnStyle}"/>
                                        <Button Content="Delete the columns and their values"
                                                Command="{Binding ColumnEditor.ConfirmForcedSaveCommand}"
                                                Style="{StaticResource SmallBtnStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Add column"
                                        Command="{Binding ColumnEditor.AddColumnCommand}"
                                        Style="{StaticResource SmallBtnStyle}"
                                        VerticalAlignment="Center"/>
                                <Button Content="{Binding ColumnEditor.SaveButtonText}"
                                        Command="{Binding ColumnEditor.SaveCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"/>
                                <TextBlock Text="{Binding ColumnEditor.SaveBlockedReason}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="360"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Visibility="{Binding ColumnEditor.SaveBlockedReason, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Share links (own lists only) -->
                    <Border Margin="0,0,0,12"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="{Binding SelectedList, Converter={StaticResource InverseNullToVisibility}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="Create share link"
                                        Command="{Binding CreateShareLinkCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"/>
                                <TextBlock Text="Public share links"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="No share links yet. Create one to share this list read-only."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShareLinks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding ShareLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ShareLink}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Top" Margin="8,0,0,0">
                                                    <Button Content="Copy"
                                                            Command="{Binding DataContext.CopyShareLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RowActionBtnStyle}"/>
                                                    <Button Content="Revoke"
                                                            Command="{Binding DataContext.RevokeShareLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RowActionBtnStyle}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBox Text="{Binding Url, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                             FontSize="11"
                                                             FontFamily="JetBrains Mono, Consolas"
                                                             TextWrapping="Wrap"
                                                             Padding="0"/>
                                                    <TextBlock Text="{Binding RoleLabel}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Watchers (own lists only) -->
                    <Border Margin="0,0,0,12"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="{Binding SelectedList, Converter={StaticResource InverseNullToVisibility}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Watchers"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- Invite by search -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="Search"
                                        Command="{Binding SearchWatcherUsersCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        Margin="8,0,0,0"/>
                                <TextBox Text="{Binding WatcherSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldStyle}"
                                         Margin="0"
                                         VerticalContentAlignment="Center"/>
                            </DockPanel>

                            <!-- Search results -->
                            <ItemsControl ItemsSource="{Binding WatcherSearchResults}"
                                          Margin="0,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:UserSearchResult}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Add"
                                                        Command="{Binding DataContext.AddWatcherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource RowActionBtnStyle}"
                                                        VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Current watchers -->
                            <TextBlock Text="No watchers yet. Search above to invite someone."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Watchers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Watchers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Collaborator}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.RemoveWatcherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource RowActionBtnStyle}"
                                                        VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayNameOrUsername}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Handle}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding RoleLabel, StringFormat=' · {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ListRowViewModel}">
                                <Border Margin="0,0,0,6"
                                        Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsViewingShared, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Edit"
                                                    Command="{Binding DataContext.StartEditRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionBtnStyle}"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DataContext.DeleteRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionBtnStyle}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <!-- Typed cells, one per visible column -->
                                            <ItemsControl ItemsSource="{Binding Cells}"
                                                          Visibility="{Binding HasSchema, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ListRowCellViewModel}">
                                                        <ContentControl Content="{Binding}" Style="{StaticResource RowCellStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Schema-less list: the freeform JSON preview it has always had -->
                                            <TextBlock Text="{Binding RawSummary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBodyBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasSchema, Converter={StaticResource InverseBoolToVisibility}}"/>

                                            <!-- Values whose column is gone: still stored, so still shown -->
                                            <TextBlock Text="{Binding OrphanSummary}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding OrphanSummary, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Typed row form (#21) ───────────────────────────────────
                         Generated from the list's live schema: one control per
                         column, keyed by the column's KEY. Values the form doesn't
                         touch are re-sent verbatim because a row write replaces
                         rowData wholesale. -->
                    <Border Margin="0,4,0,0"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10"
                            Visibility="{Binding RowEditor.IsOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="Close"
                                        Command="{Binding RowEditor.CancelCommand}"
                                        Style="{StaticResource RowActionBtnStyle}"/>
                                <TextBlock Text="{Binding RowEditor.HeaderText}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding RowEditor.Fields}"
                                          ItemTemplate="{StaticResource RowFieldTemplate}"/>

                            <CheckBox Content="Show columns saved as hidden"
                                      IsChecked="{Binding RowEditor.ShowHiddenColumns}"
                                      Style="{StaticResource MicroCheckStyle}"
                                      Margin="0,0,0,4"
                                      Visibility="{Binding RowEditor.HasHiddenColumns, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding RowEditor.OrphanNote}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AmberBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding RowEditor.OrphanNote, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                            <TextBlock Text="{Binding RowEditor.ErrorMessage}"
                                       FontSize="11"
                                       Foreground="#FFE81123"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding RowEditor.ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancel"
                                        Command="{Binding RowEditor.CancelCommand}"
                                        Style="{StaticResource RowActionBtnStyle}"
                                        Margin="0,0,6,0"/>
                                <Button Content="{Binding RowEditor.SaveButtonText}"
                                        Command="{Binding RowEditor.SaveCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inline row editor -->
                    <Border Margin="0,4,0,0"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,8"
                            Visibility="{Binding IsEditingRow, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Edit row (JSON)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditRowJson, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="JetBrains Mono, Consolas"
                                     MinHeight="60" MaxHeight="160"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Cancel" Command="{Binding CancelEditRowCommand}"
                                        Style="{StaticResource RowActionBtnStyle}" Margin="0,0,6,0"/>
                                <Button Content="Save" Command="{Binding SaveRowEditCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Add row -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <!-- The hatch: a schema-less list has only this, and a
                             schema'd one can still drop into it. -->
                        <CheckBox DockPanel.Dock="Right"
                                  Content="Edit rows as raw JSON"
                                  IsChecked="{Binding UseRawJsonRowEditor}"
                                  Style="{StaticResource MicroCheckStyle}"
                                  Margin="8,0,0,0"
                                  Visibility="{Binding HasSchema, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding RowEditorModeNote}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Typed path: the form opens above, in the rows pane -->
                    <Button Content="New row"
                            Command="{Binding StartAddRowCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Visibility="{Binding ShowTypedRowEditor, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Raw-JSON path -->
                    <StackPanel Visibility="{Binding ShowRawJsonRowEditor, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Paste a JSON object, e.g. {&quot;name&quot;: &quot;Widget&quot;, &quot;price&quot;: 9.99}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewRowJson, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="JetBrains Mono, Consolas"
                                 MinHeight="60" MaxHeight="140"/>
                        <Button Content="Add row"
                                Command="{Binding AddRowCommand}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryBtnStyle}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding RowErrorMessage}"
                               Foreground="#FFE81123"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding RowErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
