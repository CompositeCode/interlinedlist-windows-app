<UserControl x:Class="InterlinedList.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:models="clr-namespace:InterlinedList.Models"
             xmlns:local="clr-namespace:InterlinedList.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
        <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility"/>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle row action (Edit / Delete) -->
        <Style x:Key="RowActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left pane: create + browse lists ─────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Lists"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="16,16,16,12"/>

                <!-- Create list form -->
                <StackPanel Grid.Row="1" Margin="16,0,16,12">
                    <TextBox Text="{Binding NewListTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}"
                             Tag="Title"/>
                    <TextBox Text="{Binding NewListDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="52"/>
                    <Button Content="Create list"
                            Command="{Binding CreateListCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryBtnStyle}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFE81123"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                    <TextBlock Text="Loading…"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Lists browser -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,0,16,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Lists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ListSummary}">
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       Margin="0,2,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="View"
                                                        Command="{Binding DataContext.SelectListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtnStyle}"/>
                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.DeleteListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtnStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shared with me -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SharedWithMe.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Shared with me"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding SharedWithMe}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WatchedList}">
                                        <Button Command="{Binding DataContext.SelectSharedListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Margin="0,0,0,8">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="10,8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding OwnerHandle}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding RoleLabel, StringFormat=' · {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Right pane: selected list's rows ──────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <!-- Own-list title (hidden while viewing a shared list) -->
                    <TextBlock Text="{Binding SelectedList.Title}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Shared-list read-only header -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsViewingShared, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedSharedList.Title}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding SelectedSharedList.OwnerHandle, StringFormat='shared by {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,3,0,0"/>
                        <TextBlock Text="{Binding SelectedSharedList.RoleLabel, StringFormat=' · {0} · read-only'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Select a list to view its rows."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="{Binding SelectedList, Converter={StaticResource InverseNullToVisibility}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Loading…"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsLoadingRows, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,12">
                <StackPanel>
                    <!-- Share links (own lists only) -->
                    <Border Margin="0,0,0,12"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="{Binding SelectedList, Converter={StaticResource InverseNullToVisibility}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="Create share link"
                                        Command="{Binding CreateShareLinkCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"/>
                                <TextBlock Text="Public share links"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="No share links yet. Create one to share this list read-only."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShareLinks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding ShareLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ShareLink}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Top" Margin="8,0,0,0">
                                                    <Button Content="Copy"
                                                            Command="{Binding DataContext.CopyShareLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RowActionBtnStyle}"/>
                                                    <Button Content="Revoke"
                                                            Command="{Binding DataContext.RevokeShareLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RowActionBtnStyle}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBox Text="{Binding Url, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                             FontSize="11"
                                                             FontFamily="JetBrains Mono, Consolas"
                                                             TextWrapping="Wrap"
                                                             Padding="0"/>
                                                    <TextBlock Text="{Binding RoleLabel}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Watchers (own lists only) -->
                    <Border Margin="0,0,0,12"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="{Binding SelectedList, Converter={StaticResource InverseNullToVisibility}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Watchers"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- Invite by search -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="Search"
                                        Command="{Binding SearchWatcherUsersCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        Margin="8,0,0,0"/>
                                <TextBox Text="{Binding WatcherSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldStyle}"
                                         Margin="0"
                                         VerticalContentAlignment="Center"/>
                            </DockPanel>

                            <!-- Search results -->
                            <ItemsControl ItemsSource="{Binding WatcherSearchResults}"
                                          Margin="0,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:UserSearchResult}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Add"
                                                        Command="{Binding DataContext.AddWatcherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource RowActionBtnStyle}"
                                                        VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Current watchers -->
                            <TextBlock Text="No watchers yet. Search above to invite someone."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Watchers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Watchers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Collaborator}">
                                        <Border Margin="0,0,0,6"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.RemoveWatcherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource RowActionBtnStyle}"
                                                        VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource Surface2Brush}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayNameOrUsername}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Handle}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding RoleLabel, StringFormat=' · {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ListDataRow}">
                                <Border Margin="0,0,0,6"
                                        Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsViewingShared, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Edit"
                                                    Command="{Binding DataContext.StartEditRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionBtnStyle}"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DataContext.DeleteRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionBtnStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplaySummary}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextBodyBrush}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline row editor -->
                    <Border Margin="0,4,0,0"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,8"
                            Visibility="{Binding IsEditingRow, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Edit row (JSON)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditRowJson, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="JetBrains Mono, Consolas"
                                     MinHeight="60" MaxHeight="160"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Cancel" Command="{Binding CancelEditRowCommand}"
                                        Style="{StaticResource RowActionBtnStyle}" Margin="0,0,6,0"/>
                                <Button Content="Save" Command="{Binding SaveRowEditCommand}"
                                        Style="{StaticResource PrimaryBtnStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Add row -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsViewingShared}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Paste a JSON object, e.g. {&quot;name&quot;: &quot;Widget&quot;, &quot;price&quot;: 9.99}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRowJson, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="JetBrains Mono, Consolas"
                             MinHeight="60" MaxHeight="140"/>
                    <TextBlock Text="{Binding RowErrorMessage}"
                               Foreground="#FFE81123"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding RowErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                    <Button Content="Add row"
                            Command="{Binding AddRowCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryBtnStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
