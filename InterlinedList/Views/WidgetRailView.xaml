<UserControl x:Class="InterlinedList.Views.WidgetRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:models="clr-namespace:InterlinedList.Models"
             xmlns:local="clr-namespace:InterlinedList.Views"
             mc:Ignorable="d"
             d:DesignWidth="248">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:WidgetStringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:WidgetExpandGlyphConverter x:Key="ExpandGlyph"/>
        <local:WidgetChangeBrushConverter x:Key="ChangeBrush"/>

        <!-- Small square icon button used for refresh and expand/collapse. -->
        <Style x:Key="WidgetIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Surface3Brush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label: 10px uppercase meta, matching the ALERTS heading. -->
        <Style x:Key="WidgetTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WidgetMetaStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!--
            One widget card. The DataContext of each instance is a
            WidgetViewModel, so the template can bind Title / IsExpanded /
            IsLoading / Placeholder generically; the card's own content (set at
            the usage site) goes into the ContentPresenter and is shown only
            when the widget actually has content. That keeps the collapsible +
            refreshable + quiet-placeholder behaviour in exactly one place
            instead of being re-typed per widget.
        -->
        <Style x:Key="WidgetCardStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <StackPanel>

                                <!-- Header: title + subtitle, then loading dot, refresh, collapse -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource WidgetTitleStyle}"/>
                                        <!--
                                            Optional subtitle. The card is a
                                            plain ContentControl, so the usage
                                            site passes it through Tag (e.g. the
                                            resolved transit agency, or the
                                            bike-share system name).
                                        -->
                                        <TextBlock Text="{Binding Tag,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{StaticResource WidgetMetaStyle}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Tag,
                                                       RelativeSource={RelativeSource TemplatedParent},
                                                       Converter={StaticResource StringToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="···"
                                                   Style="{StaticResource WidgetMetaStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Visibility="{Binding IsLoading,
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="↻"
                                                ToolTip="Refresh"
                                                Command="{Binding RefreshCommand}"
                                                Style="{StaticResource WidgetIconBtnStyle}"/>
                                        <Button Content="{Binding IsExpanded,
                                                    Converter={StaticResource ExpandGlyph}}"
                                                ToolTip="Show or hide"
                                                Command="{Binding ToggleExpandedCommand}"
                                                Style="{StaticResource WidgetIconBtnStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Body: either the card's content, or one quiet line -->
                                <StackPanel Visibility="{Binding IsExpanded,
                                                Converter={StaticResource BoolToVisibility}}">

                                    <ContentPresenter Margin="0,8,0,0"
                                                      Visibility="{Binding HasContent,
                                                          Converter={StaticResource BoolToVisibility}}"/>

                                    <!--
                                        The degraded state. A widget upstream is a
                                        third-party proxy that can and does fail, so
                                        this line covers "empty", "no location set"
                                        and "upstream down" alike — never a dialog,
                                        never an error colour.
                                    -->
                                    <TextBlock Text="{Binding Placeholder}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding Placeholder,
                                                   Converter={StaticResource StringToVisibility}}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- Rail section heading + refresh-all -->
        <Grid Margin="0,4,0,8">
            <TextBlock Text="WIDGETS"
                       Style="{StaticResource WidgetTitleStyle}"/>
            <Button Content="↻"
                    ToolTip="Refresh all widgets"
                    Command="{Binding RefreshAllCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource WidgetIconBtnStyle}"/>
        </Grid>

        <!-- ── Top news ──────────────────────────────────────────────── -->
        <ContentControl Style="{StaticResource WidgetCardStyle}"
                        DataContext="{Binding News}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NewsItem}">
                        <Button Command="{Binding DataContext.News.OpenLinkCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Url}"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,0,8"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="4,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background"
                                                    Value="{DynamicResource Surface3Brush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextBodyBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource WidgetMetaStyle}" Margin="0,2,0,0">
                                    <Run Text="{Binding Points, Mode=OneWay}"/><Run Text=" points"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>

        <!-- ── Markets ───────────────────────────────────────────────── -->
        <ContentControl Style="{StaticResource WidgetCardStyle}"
                        DataContext="{Binding Markets}">
            <ItemsControl ItemsSource="{Binding Quotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MarketQuoteViewModel}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Symbol}"
                                       FontFamily="JetBrains Mono, Consolas"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Price}"
                                       FontFamily="JetBrains Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextBodyBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Change}"
                                       FontFamily="JetBrains Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding IsDown, Converter={StaticResource ChangeBrush}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>

        <!-- ── Transit ───────────────────────────────────────────────── -->
        <ContentControl Style="{StaticResource WidgetCardStyle}"
                        DataContext="{Binding Transit}"
                        Tag="{Binding AgencyLabel}">
            <ItemsControl ItemsSource="{Binding Stops}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TransitStop}">
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextBodyBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Direction}"
                                       Style="{StaticResource WidgetMetaStyle}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding Direction,
                                           Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>

        <!-- ── Bike share ────────────────────────────────────────────── -->
        <ContentControl Style="{StaticResource WidgetCardStyle}"
                        DataContext="{Binding BikeShare}"
                        Tag="{Binding SystemName}">
            <StackPanel>
                <TextBlock Text="{Binding Availability}"
                           FontSize="11"
                           Foreground="{DynamicResource TextBodyBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Visibility="{Binding Availability,
                               Converter={StaticResource StringToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Stations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BikeShareStationViewModel}">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextBodyBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource WidgetMetaStyle}" Margin="0,2,0,0">
                                    <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Distance, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ContentControl>

    </StackPanel>
</UserControl>
