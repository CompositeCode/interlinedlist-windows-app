<UserControl x:Class="InterlinedList.Views.InvitePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InterlinedList.ViewModels"
             xmlns:models="clr-namespace:InterlinedList.Models"
             xmlns:local="clr-namespace:InterlinedList.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="620">

    <!--
        "Invite people" — the card the web Share window leads with. Reusable:
        set Kind + TargetId and it drives either /api/lists/{id}/invites or
        /api/documents/{id}/invites through IInviteTarget.

        Styles are declared locally on purpose: every view in this app carries
        its own copies (there is no shared style dictionary yet), so the panel
        stays self-contained and drops into any host without new resource keys.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>

        <Style x:Key="InviteFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InvitePrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InviteRowActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented picker cell: selected state comes from the option's
             IsSelected, not from RadioButton grouping (see InviteOptionViewModel). -->
        <Style x:Key="InviteChoiceBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface2Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10"
            Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>

            <!-- Header -->
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource InviteRowActionBtnStyle}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Invite people"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding PrivacyNote}"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Not the owner: sharing is owner-only, even for an Admin collaborator -->
            <Border Margin="0,0,0,8"
                    Background="{DynamicResource Surface3Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,8"
                    Visibility="{Binding ShowNotOwnerNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NotOwnerNote}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Free account: locked, not hidden, with an Upgrade prompt (matches the web) -->
            <Border Margin="0,0,0,8"
                    Background="{DynamicResource Surface3Brush}"
                    BorderBrush="{DynamicResource AmberBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,8"
                    Visibility="{Binding ShowUpgradePrompt, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Locked — upgrade to invite people"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding UpgradeNote}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Invite form (owner only; disabled but visible for a free account) -->
            <StackPanel IsEnabled="{Binding CanManage}"
                        Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Email address"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding InviteEmail, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InviteFieldStyle}"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Role"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Roles}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InviteOptionViewModel}">
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.SelectRoleCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource InviteChoiceBtnStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Roles}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InviteOptionViewModel}">
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Expires"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Expiries}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InviteOptionViewModel}">
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.SelectExpiryCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource InviteChoiceBtnStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Send invite"
                        Command="{Binding SendInviteCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource InvitePrimaryBtnStyle}"/>

                <TextBlock Text="An invite email is sent to this address with an Accept link. They must sign in with that same address, verified, to accept — a forwarded link won't work for anyone else."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FFE81123"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

            <!-- Pending invites -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Pending invites"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="{Binding EmptyNote}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Invites.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Invites}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EmailInvite}">
                            <Border Margin="0,0,0,6"
                                    Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Button Content="Copy link"
                                                Command="{Binding DataContext.CopyInviteLinkCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource InviteRowActionBtnStyle}"/>
                                        <!-- Revoke is not subscriber-gated: a lapsed owner can
                                             always shut off access they already granted. -->
                                        <Button Content="Revoke"
                                                Command="{Binding DataContext.RevokeInviteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanRevoke}"
                                                Style="{StaticResource InviteRowActionBtnStyle}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Email}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MetaLine}"
                                                   FontSize="11"
                                                   FontFamily="JetBrains Mono, Consolas"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
