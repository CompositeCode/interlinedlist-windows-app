<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 mp rescap">

  <Identity
    Name="InterlinedList"
    Publisher="CN=REPLACE-WITH-PARTNER-CENTER-PUBLISHER-ID"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="08ff27c8-1f81-4a8f-b4b4-f7471e74710a" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>InterlinedList</DisplayName>
    <PublisherDisplayName>InterlinedList</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="InterlinedList" Executable="InterlinedList.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="InterlinedList"
        Description="Signal streams, live."
        BackgroundColor="#0C2C3A"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:SplashScreen Image="Images\SplashScreen.png" BackgroundColor="#0C2C3A" />
      </uap:VisualElements>
    </Application>

    <!-- Background document-sync tray utility. Auto-launches at login via the
         windows.startupTask extension (the MSIX equivalent of the MSI's Run key).

         NOTE the subdirectory in Executable, and don't "tidy" it to a bare
         filename. Desktop Bridge flattens only the ENTRY-POINT project's output
         (EntryPointProjectUniqueName, i.e. InterlinedList.csproj) to the package
         root; every other ProjectReference is harvested into a folder named
         after the project. CI proves it:

           InterlinedList.exe      -> ...\bin\x64\Release\InterlinedList\InterlinedList.exe
           InterlinedList.Sync.exe -> ...\bin\x64\Release\InterlinedList.Sync\InterlinedList.Sync.exe

         A bare "InterlinedList.Sync.exe" therefore fails the build with
         APPX0703 "Manifest references file 'InterlinedList.Sync.exe' which is
         not part of the payload". This differs from the MSI, where the
         documented build publishes both projects into the SAME folder and WiX
         globs it — so the two packaging tracks legitimately need different
         paths here. -->
    <Application Id="InterlinedListSync" Executable="InterlinedList.Sync\InterlinedList.Sync.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="InterlinedList Sync"
        Description="Keep a local folder of documents in sync for Obsidian."
        BackgroundColor="#0C2C3A"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="InterlinedList.Sync\InterlinedList.Sync.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="InterlinedListSyncStartup" Enabled="true" DisplayName="InterlinedList Sync" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
